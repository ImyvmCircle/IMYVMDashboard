# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# managed large resources
/public/resources/external/*
!/public/resources/external/.gitkeep
/public/resources/downloads/*
!/public/resources/downloads/.gitkeep
/public/resources/packages/*
!/public/resources/packages/.gitkeep
/public/resources/minecraft/*
!/public/resources/minecraft/.gitkeep
!/public/resources/minecraft/block/
/public/resources/minecraft/block/*
!/public/resources/minecraft/block/.gitkeep
/resources/cache/
/resources/packages/*
!/resources/packages/.gitkeep
